{
  "name": "http-session",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint-staged": "lint-staged",
    "test": "bun run test:vitest && bun run test:bun",
    "test:vitest": "vitest run",
    "test:bun": "bun test tests/bun",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": ["biome check --write --no-errors-on-unmatched"],
    "*.md": ["biome format --write --no-errors-on-unmatched"]
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
